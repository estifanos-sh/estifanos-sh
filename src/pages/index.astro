---
import SiteHeader from "../components/SiteHeader.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
---

<LandingLayout
  description="Estifanos LLC is an engineering company founded to build durable, human-centered software."
  favicon="/estifanos-mark-orange.svg"
  site="com"
  title="estifanos.com"
>
  <div class="site">
    <SiteHeader site="com" />
    <main class="profile"><div class="profile-copy">
      <p>Estifanos LLC is an engineering company founded to build durable, human-centered software.</p>
      <p>Current work includes technical direction for <a href="https://trestle.inc/">@trestle</a> and open-source SDK development for <a href="https://convex.dev/">@convex</a>. Software published by Estifanos is documented at <a href="https://estifanos.sh/">@estifanos.sh</a>.</p>
      <p>Consulting and other inquiries: <a href="mailto:robel@estifanos.com">robel@estifanos.com</a>.</p>
    </div></main>
  </div>
</LandingLayout>
