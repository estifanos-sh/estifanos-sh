---
import SiteHeader from "../components/SiteHeader.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
---

<LandingLayout
  description="Estifanos LLC is an engineering company founded to build durable, human-centered software."
  favicon="/estifanos-mark-orange.svg"
  site="com"
  title="Not found | estifanos.com"
>
  <Fragment slot="head"><meta content="noindex" name="robots" /></Fragment>
  <div class="site">
    <SiteHeader site="com" />
    <main class="profile">
      <h1>Page not found</h1>
      <div class="profile-copy">
        <p>
          That address does not exist on this site. <a href="/">Return to the home page</a>, or read
          the documentation at <a href="https://estifanos.sh/">@estifanos.sh</a>.
        </p>
      </div>
    </main>
  </div>
</LandingLayout>