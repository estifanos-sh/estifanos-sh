---
import "../app.css";
import interFont from "../assets/fonts/inter.woff2";
import interTightFont from "../assets/fonts/intertight.woff2";
import { project } from "../generated/project";

interface DocumentationPage {
  description: string;
  html: string;
  markdown: string;
  slug: string;
  title: string;
}

interface SidebarItem {
  slug: string;
  title: string;
}

interface SidebarGroup {
  items: SidebarItem[];
  label: string;
}

interface Project {
  description: string;
  id: string;
  installCommand: string;
  repository: string;
  sidebar: SidebarGroup[];
  startSlug: string;
  title: string;
}

const docsProject = project as Project;
const { page } = Astro.props as { page: DocumentationPage };
const base = `${import.meta.env.BASE_URL}/`;
const overview = page.slug === docsProject.startSlug;
const navigation = docsProject.sidebar.flatMap((group) =>
  group.items.map((item) => ({ ...item, section: group.label })),
);
const current = page.slug;
const section = navigation.find((item) => item.slug === current)?.section;
const currentIndex = navigation.findIndex((item) => item.slug === current);
const previous = currentIndex > 0 ? navigation[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? navigation[currentIndex + 1] : undefined;

function href(slug: string) {
  return slug === docsProject.startSlug ? base : `${base}${slug.slice(1)}/`;
}
---

<!doctype html>
<html data-theme="convex" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={page.description} name="description" />
    <meta content="#f7eedb" name="theme-color" />
    <link href={`${base}favicon.svg?v=estifanos-engineering-1`} rel="icon" type="image/svg+xml" />
    <link href="https://use.typekit.net" rel="preconnect" />
    <link href="https://p.typekit.net" rel="preconnect" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="anonymous" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://use.typekit.net/xmd6bow.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..700&display=swap" rel="stylesheet" />
    <link as="font" crossorigin="anonymous" href={interFont} rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" href={interTightFont} rel="preload" type="font/woff2" />
    <link href={href(page.slug)} rel="canonical" />
    <title>{page.title} | {docsProject.title}</title>
  </head>
  <body data-base={base}>
    <div class="chrome chrome-docs">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <header class="masthead">
        <a class="brand-lockup" href={base}>
          <img alt="Convex" class="brand-wordmark" height="36" src={`${base}brand/convex-logo-white.svg`} width="92" />
        </a>
        <div class="masthead-actions">
          <button class="search-chip" data-search-open type="button">
            <svg aria-hidden="true" fill="none" height="18" viewBox="0 0 24 24" width="18"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle><path d="m16 16 4 4" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path></svg>
            <span>Search</span><kbd>⌘K</kbd>
          </button>
          <a class="github-button" href={`https://github.com/${docsProject.repository}`}>
            <svg aria-hidden="true" fill="currentColor" height="18" viewBox="0 0 24 24" width="18"><path d="M12 .7A11.3 11.3 0 0 0 8.4 22.72c.57.1.77-.25.77-.55v-2.15c-3.15.68-3.81-1.34-3.81-1.34-.5-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.7.08-.7 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.4-1.22.7-1.5-2.52-.28-5.18-1.26-5.18-5.61 0-1.24.44-2.25 1.17-3.05-.12-.28-.51-1.44.11-3 0 0 .95-.3 3.1 1.16A10.72 10.72 0 0 1 12 6.04c.96 0 1.92.13 2.82.38 2.15-1.46 3.1-1.16 3.1-1.16.62 1.56.23 2.72.11 3 .73.8 1.17 1.81 1.17 3.05 0 4.36-2.67 5.33-5.2 5.61.4.35.76 1.03.76 2.07v3.07c0 .3.2.66.78.55A11.3 11.3 0 0 0 12 .7Z"></path></svg>
            <span>GitHub</span>
          </a>
          <button aria-controls="mobile-docs-nav" aria-expanded="false" aria-label="Open documentation menu" class="icon-btn menu-btn" data-menu-open type="button">
            <svg aria-hidden="true" fill="none" height="20" viewBox="0 0 24 24" width="20"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path></svg>
          </button>
        </div>
      </header>
      {overview && <section aria-label={`${docsProject.title} by Estifanos`} class="brand-strip">
        <div class="brand-strip-inner">
          <div class="brand-strip-copy">
            <p class="brand-strip-title">{docsProject.title} <span>By Estifanos</span></p>
            <p class="brand-strip-deck">{docsProject.description}</p>
          </div>
          <div class="install-panel">
            <p>Install {docsProject.title}</p>
            <button aria-label="Copy install command" data-copy-install data-install={docsProject.installCommand} type="button"><code>{docsProject.installCommand}</code><span data-copy-label>Copy</span></button>
          </div>
        </div>
      </section>}
      <div class="docs-frame">
        <aside class="rail">
          <nav aria-label="Documentation">
            {docsProject.sidebar.map((group) => <details class="rail-group" open={group.items.some((item) => item.slug === current)}>
              <summary>{group.label}</summary>
              <ul>{group.items.map((item) => <li><a aria-current={item.slug === current ? "page" : undefined} class:list={{ active: item.slug === current }} href={href(item.slug)}>{item.title}</a></li>)}</ul>
            </details>)}
          </nav>
        </aside>
        <main class="doc-pane" id="main-content">
          <div class="doc-grid"><div class="doc-content">
            <header class="doc-hero">
              {section && <p class="eyebrow">{section}</p>}
              <h1>{page.title}</h1>
              <p class="lede">{page.description}</p>
            </header>
            <article class="doc-prose" data-pagefind-body set:html={page.html} tabindex="-1"></article>
            <nav aria-label="Adjacent documentation pages" class="pager">
              {previous && <a class="pager-link" href={href(previous.slug)}><span>Previous</span><strong>{previous.title}</strong></a>}
              {next && <a class:list={{ "pager-link": true, "pager-next": true }} href={href(next.slug)}><span>Next</span><strong>{next.title}</strong></a>}
            </nav>
          </div></div>
        </main>
        <footer class="site-foot"><div class="site-foot-inner">
          <div class="site-foot-primary"><p class="site-foot-built">Built with <span aria-label="love">♥</span> by <a href="https://estifanos.com">estifanos.com</a></p></div>
          <nav aria-label="Footer" class="site-foot-links"><a href={base}>Overview</a><a href={`https://github.com/${docsProject.repository}`}>GitHub</a></nav>
        </div></footer>
      </div>
      <div class="overlay" data-menu hidden>
        <button aria-label="Close navigation" class="scrim" data-menu-close></button>
        <nav class="drawer" id="mobile-docs-nav"><div class="drawer-head"><strong>Documentation</strong><button aria-label="Close navigation" class="drawer-close" data-menu-close type="button">×</button></div>
          {docsProject.sidebar.map((group) => <details class="rail-group" open={group.items.some((item) => item.slug === current)}><summary>{group.label}</summary><ul>{group.items.map((item) => <li><a class:list={{ active: item.slug === current }} href={href(item.slug)}>{item.title}</a></li>)}</ul></details>)}
        </nav>
      </div>
      <div class="overlay search-overlay" data-search hidden>
        <button aria-label="Close search" class="scrim" data-search-close></button>
        <section aria-label="Search documentation" aria-modal="true" class="search-sheet" role="dialog">
          <div class="search-field"><svg aria-hidden="true" fill="none" height="18" viewBox="0 0 24 24" width="18"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle><path d="m16 16 4 4" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path></svg><input aria-label="Search documentation" data-search-input placeholder="Search documentation" /><kbd>ESC</kbd><button aria-label="Close search" class="search-close" data-search-close type="button">×</button></div>
          <p class="search-empty" data-search-empty>Search guides and API reference.</p><ol class="search-hits" data-search-hits></ol>
        </section>
      </div>
    </div>
    <script is:inline>
      const base = document.body.dataset.base || "/";
      const menu = document.querySelector("[data-menu]");
      const search = document.querySelector("[data-search]");
      const input = document.querySelector("[data-search-input]");
      const hits = document.querySelector("[data-search-hits]");
      const empty = document.querySelector("[data-search-empty]");
      let pagefind;
      const closeMenu = () => { menu.hidden = true; document.querySelector("[data-menu-open]").setAttribute("aria-expanded", "false"); };
      const closeSearch = () => { search.hidden = true; input.value = ""; hits.replaceChildren(); empty.hidden = false; empty.textContent = "Search guides and API reference."; };
      document.querySelector("[data-menu-open]").addEventListener("click", () => { menu.hidden = false; document.querySelector("[data-menu-open]").setAttribute("aria-expanded", "true"); });
      document.querySelectorAll("[data-menu-close]").forEach((button) => button.addEventListener("click", closeMenu));
      document.querySelector("[data-search-open]").addEventListener("click", () => { search.hidden = false; input.focus(); });
      document.querySelectorAll("[data-search-close]").forEach((button) => button.addEventListener("click", closeSearch));
      document.addEventListener("keydown", (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); if (search.hidden) document.querySelector("[data-search-open]").click(); else closeSearch(); } if (event.key === "Escape") { closeMenu(); closeSearch(); } });
      document.querySelectorAll("pre").forEach((pre) => { if (pre.parentElement.classList.contains("code-block")) return; const wrap = document.createElement("div"); wrap.className = "code-block"; pre.replaceWith(wrap); wrap.append(pre); const button = document.createElement("button"); button.className = "code-copy"; button.type = "button"; button.textContent = "Copy"; button.addEventListener("click", async () => { await navigator.clipboard.writeText(pre.textContent || ""); button.textContent = "Copied"; setTimeout(() => button.textContent = "Copy", 1600); }); wrap.append(button); });
      document.querySelector("[data-copy-install]")?.addEventListener("click", async (event) => { const button = event.currentTarget; await navigator.clipboard.writeText(button.dataset.install); button.querySelector("[data-copy-label]").textContent = "Copied"; setTimeout(() => button.querySelector("[data-copy-label]").textContent = "Copy", 1600); });
      let pagefindPromise;
      const loadPagefind = () => pagefindPromise ??= import(`${base}pagefind/pagefind.js`).then(async (module) => { await module.init(); return module; });
      document.querySelector("[data-search-open]").addEventListener("click", () => { void loadPagefind(); });
      input.addEventListener("input", async () => { const query = input.value.trim(); hits.replaceChildren(); if (!query) { empty.hidden = false; empty.textContent = "Search guides and API reference."; return; } pagefind = await loadPagefind(); const response = await pagefind.search(query); const results = await Promise.all(response.results.slice(0, 6).map((result) => result.data())); empty.hidden = results.length > 0; if (!results.length) empty.textContent = `No results for “${query}”`; results.forEach((result) => { const item = document.createElement("li"); const anchor = document.createElement("a"); anchor.href = result.url; const title = document.createElement("strong"); title.textContent = result.meta?.title || result.url; const excerpt = document.createElement("span"); excerpt.textContent = result.excerpt.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim(); anchor.append(title, excerpt); item.append(anchor); hits.append(item); }); });
    </script>
  </body>
</html>
