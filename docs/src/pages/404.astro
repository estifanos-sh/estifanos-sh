---
import { project } from "../generated/project";
import "../app.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta content="noindex" name="robots" /><meta content="width=device-width, initial-scale=1" name="viewport" /><link href={`${base}favicon.svg`} rel="icon" type="image/svg+xml" /><title>404 | {project.title}</title></head><body><main class="not-found"><h1>404</h1><p>This page does not exist.</p><a href={base}>Return to {project.title}.</a></main></body></html>
