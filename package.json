{
  "name": "robelest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:convex": "vp exec convex dev",
    "build": "vp run cache:build",
    "preview": "vp preview",
    "check": "vp run cache:check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp run cache:test",
    "sync": "vp exec node --import tsx scripts/sync.ts",
    "sync:prod": "vp exec node --env-file=.env.production --import tsx scripts/sync.ts",
    "deploy": "vp run sync:prod && vp run cache:build && vp dlx @convex-dev/static-hosting upload --dist ./build --component staticHosting --prod",
    "deploy:dev": "vp run sync && vp run cache:build && vp dlx @convex-dev/static-hosting upload --dist ./build --component staticHosting",
    "deploy:convex": "vp exec convex deploy",
    "prepare": "vp config"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.1.3",
    "@lucide/svelte": "^0.577.0",
    "convex": "^1.33.0",
    "convex-svelte": "^0.0.12",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.13.0",
    "p-limit": "^7.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "mdsvex": "^0.12.7",
    "shiki": "^4.0.2",
    "svelte": "^5.53.11",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.11",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    },
    "allowBuilds": {
      "esbuild": true,
      "@convex-dev/static-hosting": false
    }
  }
}
