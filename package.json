{
  "name": "estifanos-sh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:convex": "vp exec convex dev",
    "build": "vp run cache:build && node scripts/sync-project-docs.mjs",
    "preview": "vp preview",
    "check": "vp run cache:check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp run cache:test",
    "sync:docs": "node scripts/sync-project-docs.mjs",
    "deploy": "vp exec convex deploy --yes && vp run cache:build && node scripts/sync-project-docs.mjs && vp exec static-hosting upload --dist ./dist/client --component staticHosting --prod",
    "deploy:dev": "vp exec convex dev --once && vp run cache:build && node scripts/sync-project-docs.mjs && vp exec static-hosting upload --dist ./dist/client --component staticHosting",
    "deploy:convex": "vp exec convex deploy --yes",
    "prepare": "vp config"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.1.4",
    "@tanstack/solid-router": "^1.170.16",
    "@tanstack/solid-start": "^1.168.26",
    "convex": "^1.41.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    },
    "allowBuilds": {
      "esbuild": true,
      "@convex-dev/static-hosting": false
    }
  }
}
